{
  "expo": {
    "name": "Resortify",
    "slug": "resortify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.biliran.booking"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.biliran.booking"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-notifications"
    ],
    "scheme": "biliranbooking",
    "owner": "abylons-team",
    "extra": {
      "eas": {
        "projectId": "ed6222dc-17e4-4e51-82e4-ee5202620f24"
      }
    }
  }
}
