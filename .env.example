# Copy to .env on every laptop. Never commit .env.

# Same value on central and all islands — tickets are signed/verified with it.
TICKET_SECRET=change-me-to-a-long-random-string

# local   = everything on 127.0.0.1
# hotspot = config/network.hotspot.json (all laptops on one Wi-Fi, edit the IPs)
# cloud   = central on Render; islands connect out to CENTRAL_URL from any internet
NETWORK=local

# Island laptops in cloud mode: central's public address (no trailing slash).
# Leave empty on a LAN/hotspot.
CENTRAL_URL=

# Central laptop only. Service-role key: server-side only, never put it in the app.
# Key: Supabase dashboard → Project Settings → API Keys → secret key (sb_secret_...).
SUPABASE_URL=https://xrpkpxxxancrogjddriw.supabase.co
SUPABASE_SERVICE_KEY=

# Island laptops, optional: fake mainland link delay for the search benchmark
LINK_LATENCY_MS=0
